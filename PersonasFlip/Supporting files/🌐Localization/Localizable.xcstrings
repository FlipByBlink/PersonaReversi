{
  "sourceLanguage" : "en",
  "strings" : {
    "“Capture and edit your Persona on Apple Vision Pro - Apple Support”" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「Apple Vision ProでPersonaを収録する/編集する」"
          }
        }
      }
    },
    "“Share apps and experiences with people nearby on Apple Vision Pro - Apple Support”" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「Apple Vision Proでアプリや体験を周囲の人と共有する - Apple サポート」"
          }
        }
      }
    },
    "“Use SharePlay in FaceTime calls on Apple Vision Pro - Apple Support”" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「Apple Vision ProでのFaceTime通話でSharePlayを使用する」"
          }
        }
      }
    },
    "\"Use spatial Persona on Apple Vision Pro - Apple Support”" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「Apple Vision Proで空間Personaを使用する」"
          }
        }
      }
    },
    "About App" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリについて"
          }
        }
      }
    },
